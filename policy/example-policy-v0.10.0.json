{
  "version": "0.10.0",
  "conformanceLevel": "L3",
  "identity": {
    "requireCurrentRegistrationLink": true,
    "treatMissingSupportedTrustAsDiscoveryOnly": true,
    "requireWalletReverificationAfterTransfer": true,
    "showWalletBindingStatus": true,
    "showWalletVerificationType": true
  },
  "safeFetch": {
    "timeoutMs": 8000,
    "maxBytes": 5242880,
    "allowedSchemes": [
      "https",
      "ipfs",
      "data"
    ],
    "allowedContentTypes": [
      "application/json",
      "text/plain"
    ],
    "followRedirects": true,
    "maxRedirects": 3,
    "ipfsGateways": [
      "https://ipfs.io/ipfs/",
      "https://cloudflare-ipfs.com/ipfs/"
    ],
    "cache": {
      "enabled": true,
      "retentionDays": 180,
      "separateUnanchoredCache": true
    },
    "dataUriPolicy": {
      "enabled": true,
      "maxBytes": 65536,
      "allowedMediaTypes": [
        "application/json",
        "text/plain"
      ],
      "inertOnly": true
    }
  },
  "reputation": {
    "weighting": {
      "ageDecayHalfLifeDays": 90,
      "clientAccountAgeWeight": 0.3,
      "clientProofWeights": {
        "did": 1,
        "vc": 1.5,
        "kyc": 2
      },
      "stakeWeight": 2.5,
      "reliabilityWeight": 1.2
    },
    "rateLimits": {
      "maxFeedbackPerAgentPerDay": 250,
      "maxResponsesPerFeedback": 50,
      "maxFetchesPerHostPerMinute": 60
    },
    "display": {
      "showScalarScore": true,
      "showConfidence": true,
      "appendResponsePolicy": "gatedByResponderPolicy",
      "distinguishResponseTypes": true
    }
  },
  "validation": {
    "requireScopeMethodFreshness": true,
    "bindToRequestHash": true,
    "invalidateOnAgentUriChange": true,
    "showSupersededResponses": true,
    "finalityRule": "quorum",
    "validatorPolicy": {
      "mode": "weightedAllowlist",
      "freshnessWindowHours": 168,
      "validators": [
        {
          "validatorAddress": "0x0000000000000000000000000000000000000001",
          "methodologyURI": "https://example.org/validators/v1/method",
          "scopeTags": [
            "endpoint-availability",
            "metadata-integrity"
          ],
          "weight": 1,
          "conflictRule": "preferQuorum"
        }
      ]
    }
  },
  "disclosures": {
    "integrityDefinition": "Integrity-aware means the consumer classifies content as anchored, unanchored, mismatched, unavailable, or malformed. Successful retrieval alone does not imply immutability, authenticity, or safety.",
    "reputationPolicyDisclosure": "Reputation scores are weighted by feedback age, client proof, optional stake signals, and reliability. Raw counts are not treated as quality.",
    "validatorDisclosure": "Validation badges include validator set, method URI, scope tags, request linkage, and freshness window. Conflicts are resolved via deterministic policy.",
    "economicDependenciesDisclosure": "This consumer does not claim economic security unless integrated with an external staking, slashing, bond, or insurance protocol."
  },
  "registryRecognition": {
    "namespace": "eip155",
    "chainId": "1",
    "identityRegistry": "0x1111111111111111111111111111111111111111",
    "reputationRegistry": "0x2222222222222222222222222222222222222222",
    "validationRegistry": "0x3333333333333333333333333333333333333333",
    "abiRevision": "erc8004-2026-01-25-pinned-draft",
    "codeHash": "0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "recognitionSource": "example-only: not a recognized public deployment"
  },
  "sourceFinality": {
    "rule": "finalized",
    "maxSnapshotAgeSeconds": 600,
    "maxClockSkewSeconds": 30,
    "proofBasis": "state-proof"
  },
  "ownerEpoch": {
    "resetOnTransfer": true,
    "priorEpochScoreMode": "separate-history-only",
    "invalidateOnUriChange": true,
    "probationBlocks": 0
  },
  "contentAdmission": {
    "reuseVerifiedBytes": true,
    "rejectZeroHashAsCommitment": true,
    "rejectDuplicateJsonKeys": true,
    "isolateNaturalLanguage": true,
    "requireSafeNetworkEgress": true
  },
  "reviewerSelection": {
    "selectionBasis": "curated-allowlist",
    "excludeCurrentOwnerAndOperators": true,
    "zeroCountMeansNoData": true,
    "requireCohortDisclosure": true
  },
  "validationAdmission": {
    "bindRegistryChain": true,
    "requireRequestCommitment": true,
    "independencePolicy": "documented-qualification",
    "reconcileLatestState": true,
    "unknownIndependence": "indeterminate"
  }
}
